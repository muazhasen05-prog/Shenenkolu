# ==============================================================================
# Shenen Kolu Woreda Prosperity Party — Environment Configuration
# ==============================================================================
# All services operate within strictly verified $0/month free-tier quotas.
# Never expose keys without the NEXT_PUBLIC_ prefix to client-side code.

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage, Realtime)
# Create a free project at https://supabase.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# 2. Public Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. LiveKit WebRTC (Audio/Video Online Meetings)
# Build Tier: $0/mo with 10,000 participant-minutes/month included.
# Create a free cloud project at https://livekit.io
# ------------------------------------------------------------------------------
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Optional fallback meeting mode (e.g., 'livekit' or 'jitsi')
NEXT_PUBLIC_MEETING_PROVIDER="livekit"

# ------------------------------------------------------------------------------
# 4. Web Push & VAPID (Zero-cost Browser Push Notifications)
# Generate with: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa..."
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:info@shenenkolu.gov.et"

# ------------------------------------------------------------------------------
# 5. Initial Super Admin Bootstrap (Optional for CLI setup)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@shenenkolu.gov.et"
INITIAL_ADMIN_PASSWORD="SecureInitialPassword123!"
INITIAL_ADMIN_FULL_NAME="System Administrator"
